#!/usr/bin/env sh

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

pattern='^(init|feat|fix|refactor|docs|style|test|chore|perf|build|ci|revert)(\([a-z0-9._-]+\))?: [a-z].+'

if ! printf '%s\n' "$commit_msg" | grep -Eq "$pattern"; then
  echo "Invalid commit message."
  echo "Use RS School / Conventional Commits style, for example:"
  echo "  feat: add new games section"
  echo "  fix: adjust mobile header"
  exit 1
fi